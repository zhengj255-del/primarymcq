# Copy to .env for local development. Every value is optional locally.

# App password. When unset the login gate is OFF (local dev / tests only) —
# in production set it as a Fly secret: fly secrets set APP_PASSWORD='...'
APP_PASSWORD=

# Where the SQLite file lives. Defaults to ./data.db in dev; /data/data.db in
# the Fly image (a persistent volume).
DB_PATH=

# Port to listen on (default 5000 in dev, 8080 in the Fly image).
PORT=

# --- AI MCQ quality (optional) -------------------------------------------
# The Quality page's corpus sweep, the Disputes page's "Adjudicate" lane and
# the edit dialog's "Suggest with AI" buttons all need this key. Leave it
# unset and the feature is simply off: those routes answer 503 and the pages
# say so. In production: fly secrets set OPENAI_API_KEY='sk-...'
OPENAI_API_KEY=

# The adjudicator model (default gpt-5.6-sol, a reasoning-class model). Any
# OpenAI chat-completions model id works; reasoning-class ids (gpt-5*, gpt-6*,
# o-series) additionally get a reasoning_effort.
MCQ_AI_MODEL=

# An OpenAI-compatible base URL, for a proxy or a compatible provider.
# Default https://api.openai.com
OPENAI_BASE_URL=
